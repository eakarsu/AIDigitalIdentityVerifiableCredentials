NODE_ENV=development
DATABASE_URL=postgresql://identity_user:change-me@localhost:5432/digital_identity
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
CLIENT_PORT=5173
CORS_ORIGINS=http://localhost:5173
# Private keys and seed phrases must never be placed here; use wallet/KMS references.
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
